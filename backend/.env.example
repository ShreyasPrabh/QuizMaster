# Django Secret Key
SECRET_KEY=django-insecure-quiz-app-super-secret-key-change-in-prod-12345

# Debug Mode (False in Production)
DEBUG=False

# Supabase PostgreSQL Connection String URI (from Supabase Dashboard -> Settings -> Database)
DATABASE_URL=postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres

# Allowed Hosts
ALLOWED_HOSTS=*
